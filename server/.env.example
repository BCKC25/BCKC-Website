# Copy this file to .env on the server and fill it in.
# NEVER commit .env or paste your access token anywhere else.

# --- Square ---
# "sandbox" for testing with fake cards, "production" for real money.
SQUARE_ENVIRONMENT=sandbox
# From developer.squareup.com > your app > Credentials (use the Sandbox or Production tab to match above).
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
# From developer.squareup.com > your app > Locations.
SQUARE_LOCATION_ID=

# --- Server ---
PORT=3000
# Sites allowed to use this checkout (comma-separated, no trailing slashes).
ALLOWED_ORIGINS=https://bigcheesekettleco.com,https://www.bigcheesekettleco.com,https://bckc25.github.io

# --- Local delivery ---
# Leave DELIVERY_FEE blank to keep local delivery turned off.
# Example: DELIVERY_FEE=5.00
DELIVERY_FEE=
# Optional: orders at or above this amount get free delivery. Example: 30.00
FREE_DELIVERY_MINIMUM=
# ZIP codes you deliver to. Confirm these before turning delivery on.
DELIVERY_ZIPS=29801,29803,29805,29809,29841,29842,29860

# --- Shipping ---
# Live rates from Shippo. Get your token at apps.goshippo.com > Settings > API.
# Use the shippo_test_ token while testing, then the shippo_live_ token.
SHIPPO_API_TOKEN=
# Where packages ship from (required for Shippo rates).
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=Big Cheese Kettle Co.
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=Aiken
SHIP_FROM_STATE=SC
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
# Optional: only offer these Shippo services (comma-separated tokens), e.g.
# SHIPPO_SERVICES=usps_ground_advantage,usps_priority
SHIPPO_SERVICES=
# Optional: orders at or above this amount get the cheapest shipping option free.
FREE_SHIPPING_MINIMUM=
# Optional: limit shipping to these states (comma-separated). Blank = any US state.
SHIP_STATES=SC,GA
# Flat-rate fallback, only used if Shippo isn't set up. Blank = shipping off.
SHIPPING_FEE=

# --- Sales tax ---
# Prices already include tax. This only records the tax inside each sale in
# Square's reports; it never adds anything to what the customer pays.
# Leave blank to skip.
INCLUSIVE_TAX_PERCENT=8
